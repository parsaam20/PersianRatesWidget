<Window x:Class="PersianRatesWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نرخ لحظه‌ای بازار"
        Width="296"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Vazirmatn, IRANSans, Segoe UI, Tahoma">

    <Border Margin="10"
            FlowDirection="RightToLeft"
            Background="#EB141821"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.45"
                              Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="12,10,12,10">
            <!-- Header (Draggable) -->
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Background="Transparent"
                  Cursor="SizeAll"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Live Status Dot -->
                <Ellipse x:Name="StatusDot"
                         Grid.Column="0"
                         Width="8"
                         Height="8"
                         Fill="#F59E0B"
                         VerticalAlignment="Center"
                         Margin="0,0,7,0"/>

                <TextBlock Grid.Column="1"
                           Text="نرخ لحظه‌ای بازار"
                           Foreground="#F8FAFC"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- Compact Action Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource WidgetIconButtonStyle}"
                            Content="↻"
                            ToolTip="به‌روزرسانی دستی"
                            Click="RefreshButton_Click"/>
                    <Button x:Name="PinButton"
                            Style="{StaticResource WidgetIconButtonStyle}"
                            Content="📌"
                            FontSize="11"
                            ToolTip="تغییر حالت همیشه روی صفحه"
                            Click="PinButton_Click"/>
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WidgetIconButtonStyle}"
                            Content="—"
                            ToolTip="انتقال به نوار وظیفه (System Tray)"
                            Click="MinimizeButton_Click"/>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WidgetIconButtonStyle}"
                            Content="✕"
                            ToolTip="بستن برنامه"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Divider -->
            <Border Height="1" Background="#1AFFFFFF" Margin="0,0,0,6"/>

            <!-- Offline / Error Banner (visible only when offline or error) -->
            <Border x:Name="ErrorBanner"
                    Visibility="Collapsed"
                    Background="#29EF4444"
                    BorderBrush="#55EF4444"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,5"
                    Margin="0,0,0,6">
                <TextBlock x:Name="ErrorBannerText"
                           Text="عدم اتصال به اینترنت"
                           Foreground="#FCA5A5"
                           FontSize="11"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Rates List -->
            <ItemsControl x:Name="RatesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0DFFFFFF"
                                CornerRadius="8"
                                Padding="10,7"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Asset Name & Unit (Right side in RTL) -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#F1F5F9"
                                               FontSize="12.5"
                                               FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="#64748B"
                                               FontSize="10"
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Price & Change Badge (Left side in RTL) -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="{Binding ChangeBackgroundBrush}"
                                            CornerRadius="5"
                                            Padding="5,2"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ChangePercentText}"
                                                   Foreground="{Binding ChangeBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PriceText}"
                                                   Foreground="#FFFFFF"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="تومان"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   Margin="4,2,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Footer Status Bar -->
            <Grid Margin="2,3,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LastUpdatedText"
                           Grid.Column="0"
                           Text="در حال دریافت اطلاعات..."
                           Foreground="#94A3B8"
                           FontSize="10.5"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="هر ۶۰ ثانیه"
                           Foreground="#64748B"
                           FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>

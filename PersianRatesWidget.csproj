<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PersianRatesWidget</AssemblyName>
    <RootNamespace>PersianRatesWidget</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Lightweight Windows 11 RTL Persian financial rates desktop widget</Description>
  </PropertyGroup>

</Project>
